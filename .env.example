# MongoDB
MONGO_URI=mongodb://mongodb:27017/
DB_NAME=energy_flow_germany

# Energy-Charts
ENERGY_CHARTS_BASE_URL=https://api.energy-charts.info
ENERGY_CHARTS_BIDDING_ZONE=DE-LU

# Open-Meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_LATITUDE=51.2277
WEATHER_LONGITUDE=6.7735
WEATHER_TIMEZONE=Europe/Berlin
WEATHER_LOCATIONS=[{"location_id":"DE-DUS","location_name":"Düsseldorf, Germany","latitude":51.2277,"longitude":6.7735,"timezone":"Europe/Berlin"},{"location_id":"DE-BER","location_name":"Berlin, Germany","latitude":52.52,"longitude":13.405,"timezone":"Europe/Berlin"},{"location_id":"DE-HAM","location_name":"Hamburg, Germany","latitude":53.5511,"longitude":9.9937,"timezone":"Europe/Berlin"},{"location_id":"DE-MUC","location_name":"Munich, Germany","latitude":48.1372,"longitude":11.5756,"timezone":"Europe/Berlin"},{"location_id":"DE-FRA","location_name":"Frankfurt, Germany","latitude":50.1109,"longitude":8.6821,"timezone":"Europe/Berlin"}]

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000

# Streamlit
DASHBOARD_PORT=8501

# Ingestion
ENERGY_POLL_INTERVAL_SECONDS=900
WEATHER_POLL_INTERVAL_SECONDS=3600
HTTP_TIMEOUT_SECONDS=20
